[
 {
  "i": 0,
  "start": 0.0,
  "end": 1.26,
  "text": "You did nothing today."
 },
 {
  "i": 1,
  "start": 1.78,
  "end": 3.26,
  "text": "So why are you exhausted?"
 },
 {
  "i": 2,
  "start": 4.02,
  "end": 4.82,
  "text": "You stayed in bed."
 },
 {
  "i": 3,
  "start": 5.3,
  "end": 6.1,
  "text": "You scrolled."
 },
 {
  "i": 4,
  "start": 6.42,
  "end": 9.22,
  "text": "You watched three episodes of something you don't even like."
 },
 {
  "i": 5,
  "start": 9.76,
  "end": 13.08,
  "text": "And somehow, you feel more tired than after a busy day."
 },
 {
  "i": 6,
  "start": 13.74,
  "end": 14.38,
  "text": "Here's why."
 },
 {
  "i": 7,
  "start": 15.2,
  "end": 21.74,
  "text": "Psychologist Robert Kurzban and his colleagues argue that mental tiredness isn't really your brain running out of fuel."
 },
 {
  "i": 8,
  "start": 22.38,
  "end": 23.08,
  "text": "It's a signal."
 },
 {
  "i": 9,
  "start": 23.78,
  "end": 26.58,
  "text": "Your brain is telling you: this isn't worth it."
 },
 {
  "i": 10,
  "start": 26.9,
  "end": 27.66,
  "text": "Do something else."
 },
 {
  "i": 11,
  "start": 28.34,
  "end": 33.64,
  "text": "So when your day is full of things that don't matter to you, that signal never switches off."
 },
 {
  "i": 12,
  "start": 34.3,
  "end": 36.28,
  "text": "Boredom feels like tiredness."
 },
 {
  "i": 13,
  "start": 36.86,
  "end": 40.7,
  "text": "And lying still makes it worse, because your body follows your mind."
 },
 {
  "i": 14,
  "start": 41.44,
  "end": 43.12,
  "text": "The fix isn't more rest."
 },
 {
  "i": 15,
  "start": 43.58,
  "end": 46.04,
  "text": "It's doing something that actually matters to you."
 },
 {
  "i": 16,
  "start": 46.4,
  "end": 47.4,
  "text": "Even a short walk."
 },
 {
  "i": 17,
  "start": 48.08,
  "end": 49.34,
  "text": "Follow for more psychology."
 }
]