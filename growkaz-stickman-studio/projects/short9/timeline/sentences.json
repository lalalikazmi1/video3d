[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.66,
  "text": "Your attention span is forty-seven seconds."
 },
 {
  "i": 1,
  "start": 3.1,
  "end": 4.98,
  "text": "And it used to be a lot longer."
 },
 {
  "i": 2,
  "start": 5.8,
  "end": 11.02,
  "text": "Psychologist Gloria Mark has spent twenty years tracking how people focus on their screens."
 },
 {
  "i": 3,
  "start": 11.84,
  "end": 16.98,
  "text": "In 2004, people stayed on one screen for about two and a half minutes before switching."
 },
 {
  "i": 4,
  "start": 17.74,
  "end": 20.42,
  "text": "By 2012, it was seventy-five seconds."
 },
 {
  "i": 5,
  "start": 21.24,
  "end": 21.52,
  "text": "Now?"
 },
 {
  "i": 6,
  "start": 21.52,
  "end": 23.36,
  "text": "Forty-seven seconds."
 },
 {
  "i": 7,
  "start": 24.04,
  "end": 25.38,
  "text": "But here's the strange part."
 },
 {
  "i": 8,
  "start": 25.9,
  "end": 27.6,
  "text": "Nobody was making them switch."
 },
 {
  "i": 9,
  "start": 28.08,
  "end": 28.72,
  "text": "No ping."
 },
 {
  "i": 10,
  "start": 29.2,
  "end": 29.7,
  "text": "No message."
 },
 {
  "i": 11,
  "start": 30.36,
  "end": 34.52,
  "text": "People interrupted themselves almost as often as they were interrupted by others."
 },
 {
  "i": 12,
  "start": 35.06,
  "end": 37.2,
  "text": "Just a sudden urge to check something."
 },
 {
  "i": 13,
  "start": 37.98,
  "end": 41.7,
  "text": "Your brain has learned to switch, and now it does it on its own."
 },
 {
  "i": 14,
  "start": 42.34,
  "end": 45.34,
  "text": "So next time you feel that itch to check, wait."
 },
 {
  "i": 15,
  "start": 45.86,
  "end": 47.72,
  "text": "Just forty-seven seconds more."
 },
 {
  "i": 16,
  "start": 48.3,
  "end": 49.66,
  "text": "Follow for more psychology."
 }
]