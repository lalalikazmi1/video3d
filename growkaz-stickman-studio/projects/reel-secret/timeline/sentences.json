[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.02,
  "text": "What if MrBeast gave you one million dollars…"
 },
 {
  "i": 1,
  "start": 3.44,
  "end": 5.1,
  "text": "but you could never tell anyone?"
 },
 {
  "i": 2,
  "start": 5.94,
  "end": 6.36,
  "text": "Hour one."
 },
 {
  "i": 3,
  "start": 6.82,
  "end": 7.26,
  "text": "You're fine."
 },
 {
  "i": 4,
  "start": 7.66,
  "end": 8.3,
  "text": "Totally normal."
 },
 {
  "i": 5,
  "start": 8.84,
  "end": 9.5,
  "text": "You buy a sandwich."
 },
 {
  "i": 6,
  "start": 9.5,
  "end": 10.62,
  "text": "With guac."
 },
 {
  "i": 7,
  "start": 11.4,
  "end": 11.86,
  "text": "Hour three."
 },
 {
  "i": 8,
  "start": 12.42,
  "end": 15.6,
  "text": "Your best friend says, \"Bro, why are you smiling like that?\""
 },
 {
  "i": 9,
  "start": 16.2,
  "end": 16.72,
  "text": "Day two."
 },
 {
  "i": 10,
  "start": 17.18,
  "end": 19.06,
  "text": "There's a brand new car in your driveway."
 },
 {
  "i": 11,
  "start": 19.52,
  "end": 20.22,
  "text": "Under a blanket."
 },
 {
  "i": 12,
  "start": 20.86,
  "end": 21.52,
  "text": "Your mum asks."
 },
 {
  "i": 13,
  "start": 22.0,
  "end": 24.24,
  "text": "You say it's a very big cat."
 },
 {
  "i": 14,
  "start": 24.84,
  "end": 25.44,
  "text": "Day four."
 },
 {
  "i": 15,
  "start": 25.98,
  "end": 26.64,
  "text": "You can't sleep."
 },
 {
  "i": 16,
  "start": 27.18,
  "end": 32.34,
  "text": "Scientists say people keeping a big secret think about it all the time, even when nobody's asking."
 },
 {
  "i": 17,
  "start": 32.86,
  "end": 33.6,
  "text": "So, yeah."
 },
 {
  "i": 18,
  "start": 34.1,
  "end": 34.54,
  "text": "You're cooked."
 },
 {
  "i": 19,
  "start": 35.1,
  "end": 35.6,
  "text": "Day five."
 },
 {
  "i": 20,
  "start": 36.22,
  "end": 36.64,
  "text": "You crack."
 },
 {
  "i": 21,
  "start": 37.24,
  "end": 39.26,
  "text": "You whisper it to the only one you trust."
 },
 {
  "i": 22,
  "start": 39.8,
  "end": 40.18,
  "text": "Your dog."
 },
 {
  "i": 23,
  "start": 40.72,
  "end": 41.3,
  "text": "Day six."
 },
 {
  "i": 24,
  "start": 41.76,
  "end": 42.24,
  "text": "Somehow…"
 },
 {
  "i": 25,
  "start": 42.8,
  "end": 44.04,
  "text": "the whole school knows."
 },
 {
  "i": 26,
  "start": 44.56,
  "end": 47.34,
  "text": "And then MrBeast steps out from behind a bush."
 },
 {
  "i": 27,
  "start": 47.86,
  "end": 48.8,
  "text": "\"You told the dog.\""
 }
]