[
 {
  "i": 0,
  "start": 0.0,
  "end": 4.16,
  "text": "You talked for three days, and you're already imagining a future together."
 },
 {
  "i": 1,
  "start": 4.7,
  "end": 6.82,
  "text": "Why does your brain attach so fast?"
 },
 {
  "i": 2,
  "start": 7.8,
  "end": 12.46,
  "text": "In 1997, psychologist Arthur Aron paired up complete strangers."
 },
 {
  "i": 3,
  "start": 13.24,
  "end": 17.3,
  "text": "For forty-five minutes, they asked each other a list of thirty-six questions."
 },
 {
  "i": 4,
  "start": 18.1,
  "end": 18.96,
  "text": "They started small."
 },
 {
  "i": 5,
  "start": 19.6,
  "end": 20.5,
  "text": "\"Would you like to be famous?\""
 },
 {
  "i": 6,
  "start": 21.12,
  "end": 21.92,
  "text": "And got deeper."
 },
 {
  "i": 7,
  "start": 22.7,
  "end": 24.46,
  "text": "\"What is your most treasured memory?\""
 },
 {
  "i": 8,
  "start": 25.14,
  "end": 30.26,
  "text": "By the end, many pairs felt closer to each other than to some of the people in their own lives."
 },
 {
  "i": 9,
  "start": 30.98,
  "end": 32.34,
  "text": "One pair later got married."
 },
 {
  "i": 10,
  "start": 33.12,
  "end": 34.48,
  "text": "The secret wasn't time."
 },
 {
  "i": 11,
  "start": 35.02,
  "end": 38.74,
  "text": "It was opening up, back and forth, a little more each round."
 },
 {
  "i": 12,
  "start": 39.54,
  "end": 43.0,
  "text": "That's why a few deep conversations can feel like months."
 },
 {
  "i": 13,
  "start": 43.82,
  "end": 46.7,
  "text": "But feeling close isn't the same as knowing someone."
 },
 {
  "i": 14,
  "start": 47.34,
  "end": 48.5,
  "text": "So enjoy the spark."
 },
 {
  "i": 15,
  "start": 49.12,
  "end": 50.0,
  "text": "Just give it time."
 },
 {
  "i": 16,
  "start": 50.68,
  "end": 52.0,
  "text": "Follow for more psychology."
 }
]