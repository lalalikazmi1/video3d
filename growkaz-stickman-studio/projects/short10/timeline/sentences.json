[
 {
  "i": 0,
  "start": 0.0,
  "end": 3.94,
  "text": "Why do you suddenly want to clean your room the moment you sit down to study?"
 },
 {
  "i": 1,
  "start": 4.58,
  "end": 6.02,
  "text": "It's not because you love cleaning."
 },
 {
  "i": 2,
  "start": 6.86,
  "end": 13.04,
  "text": "Psychologists Fuschia Sirois and Timothy Pychyl say procrastination isn't a time-management problem."
 },
 {
  "i": 3,
  "start": 13.5,
  "end": 15.22,
  "text": "It's a mood-management problem."
 },
 {
  "i": 4,
  "start": 15.98,
  "end": 21.82,
  "text": "When a task feels boring, hard, or uncertain, it creates a small, unpleasant feeling."
 },
 {
  "i": 5,
  "start": 22.4,
  "end": 24.72,
  "text": "And your brain wants that feeling gone."
 },
 {
  "i": 6,
  "start": 25.18,
  "end": 25.88,
  "text": "Right now."
 },
 {
  "i": 7,
  "start": 26.49,
  "end": 29.06,
  "text": "So it reaches for anything that feels better."
 },
 {
  "i": 8,
  "start": 29.66,
  "end": 30.16,
  "text": "Your phone."
 },
 {
  "i": 9,
  "start": 30.6,
  "end": 30.94,
  "text": "A snack."
 },
 {
  "i": 10,
  "start": 31.56,
  "end": 33.24,
  "text": "Suddenly, your messy room."
 },
 {
  "i": 11,
  "start": 33.98,
  "end": 35.74,
  "text": "Your brain isn't choosing the room."
 },
 {
  "i": 12,
  "start": 36.16,
  "end": 37.44,
  "text": "It's escaping the feeling."
 },
 {
  "i": 13,
  "start": 38.26,
  "end": 39.04,
  "text": "So here's the trick."
 },
 {
  "i": 14,
  "start": 39.8,
  "end": 42.86,
  "text": "Make the first step so small it doesn't feel bad."
 },
 {
  "i": 15,
  "start": 43.54,
  "end": 44.3,
  "text": "Don't write the essay."
 },
 {
  "i": 16,
  "start": 44.86,
  "end": 46.02,
  "text": "Write one sentence."
 },
 {
  "i": 17,
  "start": 46.66,
  "end": 48.14,
  "text": "Follow for more psychology."
 }
]